# ManoYug AI environment variable names only. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# AI — auto uses Gemini when GEMINI_API_KEY is set, else the labelled mock provider
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=auto

# Authentication OTP is delivered by Supabase Auth through the ZeptoMail
# custom SMTP settings configured in the Supabase dashboard.
# These app-level settings are reserved for future non-Auth transactional mail.
EMAIL_PROVIDER=auto
EMAIL_FROM=noreply@your-domain.example

# Observability (optional)
SENTRY_DSN=

# Analytics / safety
MIN_ANALYTICS_COHORT_SIZE=10

# Feature flags (optional overrides: 0|1)
# FEATURE_FLAG_CHAT_ENABLED=1
# FEATURE_FLAG_CHAT_STREAMING=1
# FEATURE_FLAG_ROSTER_CSV_IMPORT=1
# FEATURE_FLAG_APPOINTMENTS_ENABLED=1
# FEATURE_FLAG_EVAL_SUITE=1
# FEATURE_FLAG_BREAK_GLASS_ENABLED=0
